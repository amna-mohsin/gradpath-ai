# Local: copy to .streamlit/secrets.toml  (never commit that file)
# Cloud: paste these keys in Streamlit Community Cloud -> App -> Settings -> Secrets

# Leave DATABASE_URL out to use a local SQLite file while developing.
DATABASE_URL = "postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Chatbot: rule (no API needed) | gemini | openai | anthropic
CHATBOT_PROVIDER = "rule"
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-2.0-flash"
OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-4o-mini"
ANTHROPIC_API_KEY = ""
ANTHROPIC_MODEL = "claude-haiku-5-5"

# One-click demo accounts on the landing page (set "false" for a public deployment)
ENABLE_DEMO_LOGIN = "true"

